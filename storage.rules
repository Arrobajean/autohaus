rules_version = '2';

// ============================================================================
// Reglas de Storage — AutoHaus
//
//  - `cars/**`: lectura publica (fotos del inventario); escritura solo admin
//    con imagen <= 10 MB (ruta real: cars/${Date.now()}_nombre en
//    useCarImages.ts).
//  - `settings/**`: lectura publica (og/favicon del sitio); escritura solo
//    admin con imagen <= 10 MB (rutas reales: settings/og, settings/favicon).
//  - Resto: denegado.
//
// El claim se lee igual que en Firestore: request.auth.token.admin == true.
// Desplegar con: firebase deploy --only storage --project <id>
// ============================================================================
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isImage10MB() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /cars/{all=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage10MB();
    }

    match /settings/{all=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage10MB();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
